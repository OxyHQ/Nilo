{
  "name": "@nilo/api",
  "version": "1.0.0",
  "description": "Nilo API - Express backend for the Nilo workspace",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build.ts",
    "start": "bun dist/index.js",
    "lint": "biome check .",
    "test": "vitest run",
    "test:bun": "bun test --path-ignore-patterns='**/*.pgdb.test.ts' src",
    "test:pgdb": "vitest run --config vitest.pgdb.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:seed": "bun scripts/seed-dev.ts"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "0.4.2",
    "@expo-google-fonts/jetbrains-mono": "0.4.1",
    "@nilo/contracts": "workspace:*",
    "@oxy.so/core": "4.5.0",
    "@oxy.so/db": "1.0.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.1",
    "expo-server-sdk": "^6.0.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "fflate": "0.8.3",
    "ioredis": "^5.10.0",
    "jsdom": "^28.1.0",
    "pdfkit": "0.20.2",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "rate-limit-redis": "^5",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@swc/cli": "^0.5.2",
    "@swc/core": "^1.15.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^25.0.8",
    "@types/pdfkit": "^0.17.6",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
