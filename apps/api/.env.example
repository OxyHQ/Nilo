# Required PostgreSQL connection. The API refuses to boot without it.
# `bun run db:seed` refuses to run unless this names a database ending in
# `_dev`, so development points at one by default.
DATABASE_URL=postgres://nilo:nilo@localhost:5432/nilo_dev

# API and Oxy identity.
PORT=4001
WEB_URL=http://localhost:3000
OXY_API_URL=https://api.oxy.so
OXYNILO_PUBLIC_URL=http://localhost:3000

# Oxy emails an invitation's link to someone without an Oxy account
# (`lib/invite-email.ts`). Needs the `invitations:email` scope on Nilo's Oxy
# application and an OXYNILO_PUBLIC_URL registered for it; off unless `true`.
# INVITE_EMAILS_ENABLED=true

# Optional Redis/Valkey for Socket.IO scale-out.
# REDIS_URL=redis://localhost:6379
# REDIS_CA_CERT=

# Salt for hashed client addresses in rate-limit keys.
# IP_HASH_SALT=

# Attachments live in Oxy's file manager: Nilo reads them with its service
# token (workload identity in production) and stores no file itself.

# Optional browser push.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@oxy.so

# Logging.
# LOG_LEVEL=debug

# Own services use a registered workload role, with an explicit environment in Oxy.
# Locally, use temporary IAM credentials/SSO for a registered development role.
AWS_REGION=us-west-2
