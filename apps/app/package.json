{
  "name": "@nilo/app",
  "main": "index",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --clear --tunnel",
    "dev": "expo start --scheme nilo",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "generate-sitemap": "bun scripts/generate-sitemap.ts",
    "validate:api-origin": "bun scripts/validate-api-origin.ts",
    "prebuild": "bun run generate-sitemap",
    "build": "bun run validate:api-origin && bun x setup-skia-web public && bun x expo export --platform web",
    "build:production": "bun run validate:api-origin && NODE_ENV=production bun x setup-skia-web public && bun x expo export --platform web --clear",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "test": "jest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@alia.onl/sdk": "^21.5.0",
    "@expo/app-integrity": "~58.0.2",
