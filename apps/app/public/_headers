# Caching headers, honoured by Cloudflare Workers static assets.
# These are NOT documentation or a fallback: `run_worker_first` is unset, so the
# asset router answers an existing file without invoking worker/index.js. This
# file is what actually sets these headers in production.

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable
