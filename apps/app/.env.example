# Nilo workspace API. There is no checked-in production default deployment.
EXPO_PUBLIC_API_URL=http://localhost:4001

# Oxy identity. Use Nilo's active public client id from its deployment variables.
EXPO_PUBLIC_OXY_API_URL=https://api.oxy.so
EXPO_PUBLIC_OXY_CLIENT_ID=

# Expo web bundling.
EXPO_UNSTABLE_TREE_SHAKING=1
EXPO_UNSTABLE_METRO_OPTIMIZE_GRAPH=1
