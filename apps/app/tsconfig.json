{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    // TypeScript 6 no longer loads every @types package by default.
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "nativewind-env.d.ts"]
}
