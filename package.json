{
  "name": "nilo-monorepo",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "description": "Nilo - workspace for documents and databases",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/app",
    "packages/contracts",
    "packages/sdk"
  ],
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:app": "bun run --filter @nilo/app dev -- --clear --tunnel",
    "dev:api": "bun run --filter @nilo/api dev",
    "build": "bun run --filter '*' build",
    "build:app": "bun run --filter @nilo/app build",
    "build:api": "bun run --filter @nilo/api build",
    "start:app": "bun run --filter @nilo/app start",
    "start:api": "bun run --filter @nilo/api start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "android": "bun run --filter @nilo/app android",
    "ios": "bun run --filter @nilo/app ios",
    "web": "bun run --filter @nilo/app web",
    "test:worker": "bun test scripts/web-worker.test.ts scripts/service-worker.test.ts",
    "test:e2e": "vitest run --config e2e/vitest.config.ts",
    "check:api-entrypoints": "bun run build:api && bun scripts/check-api-entrypoints.ts",
    "check:bun-pin": "bun scripts/check-bun-pin.ts && bun test scripts/check-bun-pin.test.ts",
    "check:ci-wiring": "bun scripts/check-ci-wiring.ts"
  },
  "keywords": [
    "monorepo",
    "workspace",
    "expo",
    "api",
    "nilo"
  ],
  "author": "",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo-secure-store": "58.0.2",
    "react-native-screens": "4.30.0",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-keyboard-controller": "1.22.7",
    "expo": "58.0.16",
    "expo-blur": "58.0.5",
    "expo-constants": "58.0.12",
    "expo-file-system": "58.0.10",
    "expo-font": "58.0.9",
    "expo-image": "58.0.16",
    "expo-modules-core": "58.0.23",
    "@react-native-menu/menu": "2.0.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/metro-babel-transformer": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@oxy.so/bloom": "15.11.0",
    "@oxy.so/contracts": "5.7.0",
    "@oxy.so/core": "6.14.0",
    "@oxy.so/services": "12.12.0",
    "lightningcss": "1.30.1",
    "lightningcss-linux-x64-gnu": "1.30.1",
    "lightningcss-linux-x64-musl": "1.30.1",
    "@oxy.so/protocol": "1.5.0",
    "react-native-css": "3.1.0-rc.0",
    "nativewind": "5.0.0-rc.0",
    "@tiptap/pm": "3.31.4",
    "@tiptap/core": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/extension-bold": "3.31.4",
    "@tiptap/extension-code": "3.31.4",
    "@tiptap/extension-link": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-text": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-italic": "3.31.4",
    "@tiptap/extension-strike": "3.31.4",
    "@tiptap/extension-heading": "3.31.4",
    "@tiptap/extension-history": "3.31.4",
    "@tiptap/extension-document": "3.31.4",
    "@tiptap/extension-paragraph": "3.31.4",
    "@tiptap/extension-underline": "3.31.4",
    "@tiptap/extension-blockquote": "3.31.4",
    "@tiptap/extension-text-align": "3.31.4",
    "@tiptap/extension-floating-menu": "3.31.4",
    "@tiptap/extension-bubble-menu": "3.31.4"
  },
  "dependencies": {
    "@oxy.so/bloom": "15.11.0",
    "@oxy.so/contracts": "5.7.0",
    "@oxy.so/core": "6.14.0",
    "@oxy.so/services": "12.12.0"
  },
  "resolutions": {
    "react-native-css": "3.1.0-rc.0"
  }
}
